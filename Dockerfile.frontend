# ---- Stage 1: Dependencies ----
FROM node:20-alpine AS deps

WORKDIR /app

# Install dependencies needed for native modules
RUN apk add --no-cache python3 make g++ libc6-compat

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies for build stage)
RUN npm ci && npm cache clean --force

# ---- Stage 2: Builder ----
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package*.json ./

# Copy source code
COPY . .

# Set environment variables for Next.js build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js application
RUN npm run build

# ---- Stage 3: Runner ----
FROM nginx:1.27-alpine AS runner

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built application from builder stage
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/static /app/.next/static

# Copy standalone server if using Next.js standalone output
# Uncomment if next.config.js has output: 'standalone'
# COPY --from=builder /app/.next/standalone ./

# Set correct permissions
RUN addgroup -g 1001 -S nodejs && \
 adduser -S nodejs -u 1001 && \
 chown -R nodejs:nodejs /app /var/cache/nginx /var/log/nginx

USER nodejs

EXPOSE 80

STOPSIGNAL SIGTERM

CMD ["nginx", "-g", "daemon off;"]
