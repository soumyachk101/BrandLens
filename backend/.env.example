# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://brandlens:brandlens_password@localhost:5432/brandlens?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-key-here-make-it-long-and-random-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google AI
GOOGLE_API_KEY=your-google-ai-key

# Perplexity
PERPLEXITY_API_KEY=your-perplexity-key

# Stripe
STRIPE_SECRET_KEY=sk_stripe_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter
STRIPE_PRICE_GROWTH=price_growth
STRIPE_PRICE_ENTERPRISE=price_enterprise

# AWS S3
S3_BUCKET=brandlens-reports
S3_REGION=us-east-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Cloudflare R2 (alternative to S3)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=brandlens-reports

# Resend (Email)
RESEND_API_KEY=re_your_resend_key
EMAIL_FROM=noreply@brandlens.ai

# Sentry
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=development

# App
API_VERSION=v1
LOG_LEVEL=info
