{
 "compilerOptions": {
 "target": "ES2022",
 "module": "commonjs",
 "moduleResolution": "bundler",
 "rootDir": "./src",
 "outDir": "./dist",
 "strict": true,
 "esModuleInterop": true,
 "forceConsistentCasingInFileNames": true,
 "resolveJsonModule": true,
 "declaration": true,
 "declarationMap": true,
 "sourceMap": true,
 "skipLibCheck": true,
 "incremental": true,
 "types": ["node"],
 "baseUrl": ".",
 "paths": {
 "@/*": ["./src/*"]
 }
 },
 "include": ["src/**/*.ts", "prisma/**/*.prisma"],
 "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"]
}