 "@google/generative-ai": "^0.21.0",
 "@prisma/client": "^5.22.0",
 "@sentry/node": "^8.40.0",
 "aws-sdk": "^2.1692.0",
 "bcrypt": "^5.1.1",
 "bullmq": "^5.21.0",
 "dotenv": "^16.4.5",
 "fastify": "^5.1.0",
 "ioredis": "^5.4.1",
 "node-cron": "^3.0.3",
 "openai": "^4.71.1",
 "pdf-lib": "^1.17.1",
 "pino": "^9.5.0",
 "pino-pretty": "^11.3.0",
 "puppeteer": "^23.8.0",
 "resend": "^4.0.1",
 "stripe": "^17.3.1",
 "uuid": "^11.0.3",
 "zod": "^3.23.8"
 },
